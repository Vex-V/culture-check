# Copy to .env.

# Reads the frames, merges the cues, writes the brief.
OPENAI_API_KEY=
# The hackathon key (hackathon.api.qloo.com); production keys do not work there.
QLOO_API_KEY=
QLOO_API_BASE=https://hackathon.api.qloo.com

# The vision model and the LLM; empty is vidra's default.
CC_VLM=gpt-5.4-mini
CC_LLM=gpt-5.4-mini

# Where uploads, vidra's output, reports and the Qloo cache go.
CC_DATA=data
# Uploads: the longest video accepted (seconds), and the largest file (MB).
CC_MAX_SECONDS=90
CC_MAX_MB=60
# Uploads per visitor per day, and for everyone per day.
CC_PER_VISITOR_DAY=5
CC_PER_DAY=100

# Hosted app only: the folder holding the example reports.
# CC_SEED_DIR=
